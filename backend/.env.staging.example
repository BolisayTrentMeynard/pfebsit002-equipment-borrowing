# Local STAGING settings (Week 16). Copy to `.env.staging` (git-ignored, never committed) and fill in the
# empty values. Laravel reads `.env.staging` INSTEAD of `.env` when APP_ENV=staging is set in the shell
# that runs it (the release script in chunk 2 does that), so this file must be complete on its own.
# Placeholders only: no key, password or token belongs in this example file.
#
# Differences from development (.env.example):
#   APP_ENV=staging, APP_DEBUG=false, LOG_LEVEL=info, its own database `equipment_staging`,
#   its own signing key and APP_KEY (never reuse the development ones).

APP_NAME="Equipment Borrowing (staging)"
APP_ENV=staging
# Generate with: php artisan key:generate --show   (paste the result here; do not reuse the dev key)
APP_KEY=
APP_DEBUG=false
# The staging port is confirmed in chunk 2 (proposal: 9443, so it can run next to the dev Caddy on 8443).
APP_URL=https://localhost:9443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Create the database once in phpMyAdmin or the mysql client:  CREATE DATABASE equipment_staging;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=equipment_staging
# XAMPP default account, local machine only. A real deployment needs its own limited account and password.
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Signed notifier messages (Week 14). Own key for staging: php artisan notifier:generate-key
NOTIFIER_DRIVER=signed_http
NOTIFIER_URL=https://localhost:9443/api/notifier/receive
NOTIFIER_SIGNING_KEY=
NOTIFIER_SIGNING_KEY_PREVIOUS=
NOTIFIER_TOLERANCE_SECONDS=300
# Single quotes, one line per key, restart `php artisan serve` after a change (see R11).
NOTIFIER_CA_BUNDLE=

# Load-test accounts (Week 16). The password is NOT set here. Set it in the PowerShell session that runs
# the seeder and k6, for example:  $env:LOAD_TEST_PASSWORD = '...'   (12+ characters, fake, never saved to a file)
# Optional sizes: LOAD_TEST_BORROWERS (30), LOAD_TEST_ITEMS (50), LOAD_TEST_VOLUME_REQUESTS (0 to 5000).
